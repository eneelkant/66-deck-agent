/* =========================================================================================================
   66° Deck Agent — photo strips (V.1_45)
   The dark streak photo cut to the strip, panel or band a design shows (right strip, left panel, top / bottom band),
   so the picture placed on the slide is exactly the size of what is visible: clicking it selects just that strip, and
   it can be replaced, recoloured, cropped or deleted like any picture. Cut from the 66degrees section photo; a strip
   of another width uses the nearest wider cut (stretched by at most a few percent).
   ========================================================================================================= */
var STREAK_CROPS_ = {
  R80: '',
  R120: '',
  R160: '',
  R200: '',
  R240: '',
  L160: '',
  L200: '',
  L240: '',
  T80: '',
  B80: '',
  T100: '',
  B100: '',
  T120: '',
  B120: ''
};
// Visible part of a full-bleed photo: the slide minus the opaque panels that run edge to edge (a cream panel over the
// left part leaves the right strip, a band over the top leaves the bottom...). [x0, y0, x1, y1] in slide points.
function photoRegion_(els, W, H) {
  var x0 = 0, y0 = 0, x1 = W, y1 = H;
  (els || []).forEach(function (e) {
    if (!e || (e.t !== 'rect' && e.t !== 'roundrect') || !e.fill || e.fill === 'transparent' || e.rot || e.opacity != null) return;
    if (e.y <= 1 && e.y + e.h >= H - 1) { if (e.x <= 1) x0 = Math.max(x0, e.x + e.w); else if (e.x + e.w >= W - 1) x1 = Math.min(x1, e.x); }
    if (e.x <= 1 && e.x + e.w >= W - 1) { if (e.y <= 1) y0 = Math.max(y0, e.y + e.h); else if (e.y + e.h >= H - 1) y1 = Math.min(y1, e.y); }
  });
  if (x1 - x0 < 20 || y1 - y0 < 20) return [0, 0, W, H];
  return [x0, y0, x1, y1];
}
// The cut of the streak photo for a visible region, or null (whole slide, or a shape no cut fits)
function streakCropBlob_(region, W, H) {
  var x0 = region[0], y0 = region[1], x1 = region[2], y1 = region[3];
  var full = x0 <= 1 && y0 <= 1 && x1 >= W - 1 && y1 >= H - 1;
  if (full) return null;
  var key = null, need, pick = function (prefix, sizes) {
    for (var i = 0; i < sizes.length; i++) if (sizes[i] >= need - 0.5) return prefix + sizes[i];
    return null;
  };
  if (y0 <= 1 && y1 >= H - 1 && x1 >= W - 1) { need = x1 - x0; key = pick('R', [80, 120, 160, 200, 240]); }
  else if (y0 <= 1 && y1 >= H - 1 && x0 <= 1) { need = x1 - x0; key = pick('L', [160, 200, 240]); }
  else if (x0 <= 1 && x1 >= W - 1 && y0 <= 1) { need = y1 - y0; key = pick('T', [80, 100, 120]); }
  else if (x0 <= 1 && x1 >= W - 1 && y1 >= H - 1) { need = y1 - y0; key = pick('B', [80, 100, 120]); }
  if (!key || !STREAK_CROPS_[key]) return null;
  return Utilities.newBlob(Utilities.base64Decode(STREAK_CROPS_[key]), 'image/jpeg', 'streak-' + key + '.jpg');
}
